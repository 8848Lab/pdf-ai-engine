+    replace_text(handle, page_index=0, target=target, new_text="LOW-MARKER-EXTENDED")
+
+    page = _exported_page(handle)
+    _one_span_at(page, "LOW-MARKER-EXTENDED", original_origin, size=target.size)
+    handle.close()
+
+
