    def _n1_clip(page: fitz.Page, rect: fitz.Rect, target_bbox) -> fitz.Rect:
        tb = fitz.Rect(target_bbox)
        y0, y1 = rect.y0, rect.y1
        cy = (tb.y0 + tb.y1) / 2
        for block in page.get_text("dict")["blocks"]:
            if block.get("type") != 0:
                continue
            for line in block["lines"]:
                for span in line["spans"]:
                    r = fitz.Rect(span["bbox"])
                    if max(abs(a - b) for a, b in zip(tuple(r), tuple(tb))) < 0.05:
                        continue
                    if not (r.x1 > rect.x0 and r.x0 < rect.x1 and r.y1 > rect.y0 and r.y0 < rect.y1):
                        continue
                    if _N1_SIDE == "centre":
                        above = (r.y0 + r.y1) / 2 < cy
                        below = not above
                    else:  # "partial": only spans that stick out of the target band on one side clip it
                        above = r.y0 < rect.y0 and r.y1 < rect.y1
                        below = r.y1 > rect.y1 and r.y0 > rect.y0
                    if above:
                        y0 = max(y0, r.y1)
                    elif below:
                        y1 = min(y1, r.y0)
        kept = (y1 - y0) / tb.height if tb.height else 0.0
        if kept < _N1_FLOOR:
>           raise RefusedBeforeMutation(
