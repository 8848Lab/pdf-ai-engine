+_RENDERED_BAND_SIZE = 100.0  # pt: one pixel is 0.01 of the font size
+_RENDERED_BAND_BASELINE = 200.0
+_RENDERED_INK_THRESHOLD = 200  # gray level; includes light antialiasing
