+def _owners_form(value_size, value_y=100):
+    d = fitz.open()
+    p = d.new_page()
+    p.insert_text((72, 100), "Student Name:", fontsize=12)
+    p.draw_rect(fitz.Rect(160, 86, 400, 106), width=0.8)
+    p.insert_text((164, value_y), "Jo Lee", fontsize=value_size)
+    return d.tobytes()
