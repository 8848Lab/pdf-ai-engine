+
+def _linked(source, target, count=3) -> bytes:
+    doc = fitz.open(stream=labelled(count), filetype="pdf")
+    doc[source].insert_link({"kind": fitz.LINK_GOTO, "from": fitz.Rect(72, 88, 120, 104), "page": target})
+    return doc.tobytes()
